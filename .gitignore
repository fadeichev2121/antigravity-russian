# Local app bundles, archives, state and credentials must never be published.
*.app/
*.asar
*.asar.unpacked/
state/
recovery/
backup-*/
work/
packages/
download.*/
build-summary*.json
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
*.log

# Vendor installers and executable payloads stay outside this repository.
*.exe
*.dmg
*.7z
*.zip
*.tar.gz

# Disposable CI reports.
test-results/
